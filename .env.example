# Terra environment variables
#
# Copy to .env and adjust:
#   cp .env.example .env
#
# Load before running services (or export individually):
#   set -a && source .env && set +a
#
# Local quickstart (make dev):
#   make run-llm / run-analyzer / run-server / run-web
#
# Docker Compose playground (make up):
#   compose.yaml reads this file; api is published on 127.0.0.1:8080 only.

# ---------------------------------------------------------------------------
# Access gate (terra serve)
# Empty = open API (fine for make dev). Non-empty required before any non-loopback publish.
# Compose UI: paste token in the unlock panel after a 401 (sessionStorage).
# ---------------------------------------------------------------------------

# Required for `make up`: the api container binds 0.0.0.0 and refuses to
# start with an empty token.
TERRA_TOKEN=change-me

# ---------------------------------------------------------------------------
# Live preview (Compose Phase 1b — set automatically in compose.yaml)
# make dev leaves these unset → host-exec preview on loopback ports.
# ---------------------------------------------------------------------------

# TERRA_PREVIEW_MODE=docker
# TERRA_CHECKOUT_DIR=/data/checkouts
# TERRA_CHECKOUT_VOLUME=terra-data   # named volume for sibling -v (Compose)
# # TERRA_HOST_CHECKOUT_DIR=/abs/host/checkouts  # alt: bind-mount remap
# TERRA_PUBLIC_URL=http://127.0.0.1:8080
# TERRA_TRACE_HOST=host.docker.internal
# TERRA_PREVIEW_NETWORK=terra-net
# TERRA_PREVIEW_MAX=2
# TERRA_PREVIEW_TTL=30m
# TERRA_PREVIEW_IMAGE=node:22-bookworm

# ---------------------------------------------------------------------------
# Go backend (terra serve, terra map)
# Read by: internal/graph, internal/scan
# ---------------------------------------------------------------------------

# Where the Python analyzer listens.
# make dev: http://localhost:8010
# Compose sets this to http://analyzer:8010 for the api service (overrides below).
TERRA_ANALYZER_URL=http://localhost:8010

# GitHub PAT for analyze (HEAD resolve + tarball download).
# Without it, Terra shares GitHub's ~60 REST requests/hour/IP quota and will
# rate-limit quickly. A classic PAT with public-repo read (contents:read) raises
# that to ~5,000/hour. Compose passes this into the api container.
# GITHUB_TOKEN=

# Wall-clock cap for one analyze job (Go duration). Default 15m.
# TERRA_ANALYZE_TIMEOUT=15m

# Per-IP rate limit on jobs/preview/ask routes (requests/sec, 0 disables).
# Default 2; burst = 10x.
# TERRA_RATE_LIMIT=2

# Max analyze jobs in flight; extra requests get 429. Default 4.
# TERRA_ANALYZE_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Python analyzer (make run-analyzer / Compose analyzer)
# Read by: analyzer/terra_analyzer/inference/config.py
# ---------------------------------------------------------------------------

# OpenAI-compatible Chat Completions base URL.
# Bare host (http://localhost:8020) or full /v1 URL both work.
#
# make dev / make run-llm:
#   TERRA_LLM_URL=http://localhost:8020/v1
# Compose + hosted provider (recommended for `make up`):
#   TERRA_LLM_URL=https://api.openai.com/v1
# Compose + local HF profile (`make up-llm`):
#   TERRA_LLM_URL=http://llm:8020/v1
#
# WARNING: inside Compose, `localhost` is the analyzer container itself — not
# your Mac. For `make up` / `make up-llm`, override this to a hosted URL or
# http://llm:8020/v1 (compose.yaml already defaults to the llm hostname when
# the var is unset — an uncommented localhost value here would override that
# and break `make up-llm`, so leave it commented unless running `make dev`).
# make dev:
# TERRA_LLM_URL=http://localhost:8020/v1
# make up (hosted provider, recommended):
TERRA_LLM_URL=https://api.openai.com/v1

# Optional Bearer token for hosted OpenAI-compatible providers.
# Empty/unset = no Authorization header (local HF server).
# TERRA_LLM_API_KEY=

# Model id sent in chat/completions requests.
TERRA_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Seconds to wait for a chat/completions response (read timeout). Default 600.
# TERRA_LLM_TIMEOUT=600

# NOTE: the workspace model picker overrides TERRA_LLM_URL / TERRA_MODEL /
# TERRA_LLM_API_KEY for the job it was used on. The values above stay the
# fallback for the CLI, for `POST /analyze`, and for any job enqueued without
# a model_id.

# ---------------------------------------------------------------------------
# Local HF model server (make run-llm / Compose profile llm)
# Read by: analyzer/terra_analyzer/local_server/server.py
# ---------------------------------------------------------------------------

# Torch device: auto (mps / cuda / cpu), mps, cuda, or cpu
# Compose llm service usually wants cpu (or cuda if the host passes a GPU).
# Also read by the Go API to report GET /host/capabilities.
TERRA_DEVICE=auto

# Where the Go API reaches the sidecar to load a local model the workspace
# picker chose (POST /admin/load). Default http://localhost:8020.
# Compose: http://llm:8020
# TERRA_LOCAL_LLM_URL=http://localhost:8020

# ---------------------------------------------------------------------------
# Web dev (make run-web)
# Read by: web/vite.config.ts (proxy target for /analyze, /preview, /ask, /files)
# Can also live in web/.env when running npm run dev from web/
# ---------------------------------------------------------------------------

TERRA_API=http://localhost:8080

# ---------------------------------------------------------------------------
# Tests only
# ---------------------------------------------------------------------------

# Set to 1 to run @pytest.mark.slow tests against a live local LLM
# TERRA_SLOW=1


HF_HUB_OFFLINE=1