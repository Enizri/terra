# Terra environment variables
#
# Copy to .env and adjust:
#   cp .env.example .env
#
# Load before running services (or export individually):
#   set -a && source .env && set +a
#
# Quickstart (three terminals):
#   make run-llm        # local HF model (:8020)
#   make run-analyzer   # Python analyzer (:8010)
#   make run-server     # Go API (:8080)
#   make run-web        # Vite UI (:5173)

# ---------------------------------------------------------------------------
# Go backend (terra serve, terra map)
# Read by: internal/graph
# ---------------------------------------------------------------------------

# Where the Python analyzer listens.
TERRA_ANALYZER_URL=http://localhost:8010

# ---------------------------------------------------------------------------
# Python analyzer (make run-analyzer)
# Read by: analyzer/terra_analyzer/inference/config.py
# ---------------------------------------------------------------------------

# OpenAI-compatible Chat Completions base URL.
# Bare host (http://localhost:8020) or full /v1 URL both work.
# Swap for vLLM, Ollama OpenAI mode, or any hosted provider.
TERRA_LLM_URL=http://localhost:8020/v1

# Model id sent in chat/completions requests.
TERRA_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# ---------------------------------------------------------------------------
# Local HF model server (make run-llm)
# Read by: analyzer/terra_analyzer/local_server/server.py
# ---------------------------------------------------------------------------

# Torch device: auto (mps / cuda / cpu), mps, cuda, or cpu
TERRA_DEVICE=auto

# ---------------------------------------------------------------------------
# Web dev (make run-web)
# Read by: web/vite.config.ts (proxy target for /analyze, /preview, /ask, /files)
# Can also live in web/.env when running npm run dev from web/
# ---------------------------------------------------------------------------

TERRA_API=http://localhost:8080

# ---------------------------------------------------------------------------
# Tests only
# ---------------------------------------------------------------------------

# Set to 1 to run @pytest.mark.slow tests against a live local LLM
# TERRA_SLOW=1
