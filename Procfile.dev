# Local full-stack processes for `make dev` / `make dev-api`.
# Format: name: command  (command runs via bash from the repo root)

llm: cd backend/local-llm && HF_XET_HIGH_PERFORMANCE=1 ../.venv/bin/python -m uvicorn terra_local_llm.server:app --port 8020
analyzer: cd backend/analyzer && TERRA_LLM_URL="${TERRA_LLM_URL:-http://localhost:8020/v1}" ../.venv/bin/python -m uvicorn terra_analyzer.app:app --port 8010
api: cd backend/api && go run ./cmd/terra serve
web: cd apps/web && { test -d node_modules || npm install; } && npm run dev
