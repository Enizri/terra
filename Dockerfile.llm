# Optional local Hugging Face OpenAI-compatible server (compose profile: llm).
# Large image (torch + transformers); not started by default.
FROM python:3.12-slim-bookworm
WORKDIR /app
COPY analyzer/pyproject.toml ./analyzer/
COPY analyzer/terra_analyzer/ ./analyzer/terra_analyzer/
RUN pip install --no-cache-dir './analyzer[local]'
EXPOSE 8020
# Model download + load can take several minutes on first start.
HEALTHCHECK --interval=30s --timeout=10s --start-period=600s --retries=3 \
	CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8020/healthz')"
CMD ["uvicorn", "terra_analyzer.local_server.server:app", "--host", "0.0.0.0", "--port", "8020"]
